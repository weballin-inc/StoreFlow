<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="UTF-8-sig">
        <link rel="stylesheet" href="style/main.css">
        <script type="module" src="js/app.js"></script>
        <title>StoreFlow</title>
    </head>
<body>

<header>
    <h1>StoreFlow</h1>
</header>

<main>
    <div class="table_toolbar">
        <div class="table_toolbar_L">
            <button id="items_button">Items</button>
            <button id="sales_button">Sales</button>
            <button id="add_button">Add Item</button>
        </div>
        <div class="table_toolbar_R">
            <input id="searchInput" placeholder="Search">
        </div>
    </div>

    <table id="items" border="1" cellpadding="5">
        <thead id="table_head"></thead>
        <tbody></tbody>
    </table>
</main>

<div id="updatePanel">
    <button id="closePanel">✖</button>

    <h2 id="p_title"></h2>
    <p><strong>Type:</strong> <span id="p_type"></span></p>
    <p><strong>Year:</strong> <span id="p_year"></span></p>
    <p><strong>Publisher:</strong> <span id="p_publisher"></span></p>
    <p><strong>Available quantity:</strong> <span id="p_quantity"></span></p>
    <p><strong>Price:</strong> <span id="p_price"></span></p>

    <label>
        Quantity to sell:
        <input id="sellAmount" type="number" min="1" value="1">
    </label>

    <button id="sendSale">Send sale</button>
</div>

<div id="updateFields" style="display:none">
    <label>
        Title:
        <input id="edit_title">
    </label>
    <label>
        Type:
        <select id="edit_type">
            <option value="BOOK">BOOK</option>
            <option value="GAME">GAME</option>
            <option value="MOVIE">MOVIE</option>
        </select>
    </label>
    <label>
        Year:
        <input id="edit_year" type="number">
    </label>
    <label>
        Publisher:
        <input id="edit_publisher">
    </label>
    <label>
        Quantity:
        <input id="edit_quantity" type="number">
    </label>
    <label>
        Price:
        <input id="edit_price" type="number">
    </label>
    <button id="saveUpdate">Save update</button>
</div>

<!--<footer>
    <button id="footer">Confirm</button>
</footer>-->

<script>
    /* ------------------ ELEMENTY DOM ------------------ */
    const tableHead = document.getElementById("table_head");
    const tbody = document.querySelector("#items tbody");
    //const footer = document.getElementById("footer");

    const itemsBtn = document.getElementById("items_button");
    const salesBtn = document.getElementById("sales_button");
    const searchInput = document.getElementById("searchInput");

    /* ------------------ PANELE SELL/UPDATE ------------------ */
    const updatePanel = document.getElementById("updatePanel");
    const closePanelBtn = document.getElementById("closePanel");
    const sendSaleBtn = document.getElementById("sendSale");
    const sellAmountInput = document.getElementById("sellAmount");

    const pTitle = document.getElementById("p_title");
    const pType = document.getElementById("p_type");
    const pYear = document.getElementById("p_year");
    const pPublisher = document.getElementById("p_publisher");
    const pQuantity = document.getElementById("p_quantity");
    const pPrice = document.getElementById("p_price");

    /* ------------------ PANEL UPDATE (DOM) ------------------ */
    const updateFields = document.getElementById("updateFields");

    const editTitle = document.getElementById("edit_title");
    const editType = document.getElementById("edit_type");
    const editYear = document.getElementById("edit_year");
    const editPublisher = document.getElementById("edit_publisher");
    const editQuantity = document.getElementById("edit_quantity");
    const editPrice = document.getElementById("edit_price");

    const saveUpdateBtn = document.getElementById("saveUpdate");

    /* ------------------ STAN ------------------ */
    let currentView = "items";
    let typeFilter = "ALL";
    let dateSortOrder = "desc";
    let mediaTitleMap = {};

    let allItems = [];
    let allSales = [];
    let searchQuery = "";

    let selectedItemId = null;
    let panelMode = null; // "SELL" | "UPDATE"

    /* ------------------ PLACEHOLDER ------------------ */
    //function updateSearchPlaceholder() {
    //    if (currentView === "items") {
    //        searchInput.placeholder = "Search";
    //    } else {
    //        searchInput.placeholder = "Search";
    //    }
    //}

    /* ------------------ WYSZUKIWANIE LIVE ------------------ */
    searchInput.addEventListener("input", e => {
        searchQuery = e.target.value.toLowerCase();
        renderFilteredTable();
    });

    /* ------------------ NAGŁÓWKI ------------------ */
    function renderItemsHeader() {
        tableHead.innerHTML = `
            <tr>
                <th>Title</th>
                <th>
                    Type
                    <select id="typeFilter">
                        <option value="ALL">ALL</option>
                        <option value="GAME">GAME</option>
                        <option value="BOOK">BOOK</option>
                    </select>
                </th>
                <th>Release Year</th>
                <th>Publisher</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Edit record</th>
            </tr>
        `;

        const select = document.getElementById("typeFilter");
        select.value = typeFilter;

        select.onchange = e => {
            typeFilter = e.target.value;
            renderFilteredTable();
        };
    }

    function renderSalesHeader() {
        tableHead.innerHTML = `
            <tr>
                <th>Title</th>
                <th>Price</th>
                <th id="dateSort" style="cursor:pointer">
                    Date ${dateSortOrder === "asc" ? "▲" : "▼"}
                </th>
            </tr>
        `;

        document.getElementById("dateSort").onclick = () => {
            dateSortOrder = dateSortOrder === "asc" ? "desc" : "asc";
            renderFilteredTable();
        };
    }

    /* ------------------ RENDER Z FILTREM ------------------ */
    function renderFilteredTable() {
        tbody.innerHTML = "";

        if (currentView === "items") {
            let rows = allItems;

            if (typeFilter !== "ALL") {
                rows = rows.filter(item => item.media_type === typeFilter);
            }

            if (searchQuery) {
                rows = rows.filter(item =>
                    item.title.toLowerCase().includes(searchQuery)
                );
            }

            rows.forEach(item => {
                tbody.insertAdjacentHTML("beforeend", `
                    <tr>
                        <td>${item.title}</td>
                        <td>${item.media_type}</td>
                        <td>${item.release_year}</td>
                        <td>${item.publisher}</td>
                        <td>${item.quantity}</td>
                        <td>${item.price}</td>
                        <td>
                            <button onclick='openSellPanel(${JSON.stringify(item)})'>
                                Sell
                            </button>
                            <button onclick='openUpdatePanel(${JSON.stringify(item)})'>
                                Update
                            </button>
                        </td>
                    </tr>
                `);
            });
        }

        if (currentView === "sales") {
            let rows = allSales;

            if (searchQuery) {
                rows = rows.filter(sale =>
                    sale.date.toLowerCase().includes(searchQuery)
                );
            }

            rows.sort((a, b) => {
                const A = new Date(a.date);
                const B = new Date(b.date);
                return dateSortOrder === "asc" ? A - B : B - A;
            });

            rows.forEach(sale => {
                tbody.insertAdjacentHTML("beforeend", `
                    <tr>
                        <td>${sale.title}</td>
                        <td>${sale.price}</td>
                        <td>${new Date(sale.date).toLocaleString("sv-SE", {
                            year: "numeric",
                            month: "2-digit",
                            day: "2-digit",
                            hour: "2-digit",
                            minute: "2-digit",
                            hour12: false
                        }) }</td>
                    </tr>
                `);
            });
        }
    }

    /* ------------------ PANEL SELL ------------------ */
    function openSellPanel(item) {
        panelMode = "SELL";          // <-- DODANE
        selectedItemId = item.id;

        pTitle.textContent = item.title;
        pType.textContent = item.media_type;
        pYear.textContent = item.release_year;
        pPublisher.textContent = item.publisher;
        pQuantity.textContent = item.quantity;
        pPrice.textContent = item.price;

        sellAmountInput.value = 1;
        sellAmountInput.max = item.quantity;

        // <-- DODANE: ukryj UPDATE, pokaż SELL
        updateFields.style.display = "none";
        sendSaleBtn.style.display = "inline-block";
        sellAmountInput.parentElement.style.display = "block";

        updatePanel.classList.add("open");

        closePanelBtn.onclick = () => {
            updatePanel.classList.remove("open");
        };
    }

    /* ------------------ PANEL UPDATE ------------------ */
    function openUpdatePanel(item) {
        panelMode = "UPDATE";        // <-- DODANE
        selectedItemId = item.id;

        editTitle.value = item.title;
        editType.value = item.media_type;
        editYear.value = item.release_year;
        editPublisher.value = item.publisher;
        editQuantity.value = item.quantity;
        editPrice.value = item.price;

        // <-- DODANE: pokaż UPDATE, ukryj SELL
        updateFields.style.display = "block";
        sendSaleBtn.style.display = "none";
        sellAmountInput.parentElement.style.display = "none";

        updatePanel.classList.add("open");

        saveUpdateBtn.onclick = () => {
            updatePanel.classList.remove("open");
        };
    }

    /* ------------------ SEND SALE ------------------ */
    sendSaleBtn.onclick = async () => {

        if (panelMode !== "SELL" || !selectedItemId) return;

        const amount = parseInt(sellAmountInput.value);

        if (!selectedItemId || amount < 1) return;

        await fetch(`http://127.0.0.1:8000/sales/${selectedItemId}`, {
            method: "POST",
            headers: {
                "accept": "application/json",
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                amount_sold: amount
            })
        });

        updatePanel.classList.remove("open");
        loadTable("items");
    };

    /* ------------------ SEND UPDATE ------------------ */
    document.getElementById("saveUpdate").onclick = async () => {
        if (panelMode !== "UPDATE" || !selectedItemId) return;

        const payload = {
            title: edit_title.value,
            media_type: edit_type.value,
            release_year: Number(edit_year.value),
            publisher: edit_publisher.value,
            quantity: Number(edit_quantity.value),
            price: Number(edit_price.value)
        };

        await fetch(`http://127.0.0.1:8000/media/${selectedItemId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        updatePanel.classList.remove("open");
        loadTable("items");
    };

    /* ------------------ LOAD TABLE ------------------ */
    async function loadTable(type) {
        currentView = type;
        tbody.innerHTML = "";
        searchInput.value = "";
        searchQuery = "";

        //updateSearchPlaceholder();

        //footer.style.display = type === "sales" ? "flex" : "none";

        if (type === "items") {
            renderItemsHeader();

            const res = await fetch("http://127.0.0.1:8000/media?Order=asc&Limit=100&Offset=0");
            const data = await res.json();

            allItems = data.items;
            mediaTitleMap = {};

            allItems.forEach(item => {
                mediaTitleMap[item.id] = item.title;
            });

            renderFilteredTable();
        }

        if (type === "sales") {
            renderSalesHeader();

            const res = await fetch("http://127.0.0.1:8000/sales?Sort_by=SaleID&Order=desc&Limit=100&Offset=0");
            const data = await res.json();

            allSales = data.items.map(sale => ({
                ...sale,
                title: mediaTitleMap[sale.media_id] ?? "(unknown title)"
            }));

            renderFilteredTable();
        }
    }

    /* ------------------ PRZYCISKI ------------------ */
    itemsBtn.onclick = () => loadTable("items");
    salesBtn.onclick = () => loadTable("sales");

    /* ------------------ START ------------------ */
    document.addEventListener("DOMContentLoaded", () => {
        loadTable("items");
    });
</script>
</body>
</html>